# Bounty Intake VPS worker — copy to .env and edit.
ARTIFACT_URL=https://claude.ai/artifact/TkGkHfaqL285Rb1AWxfrfu
# Local Immunefi JSON mirror (browser-less Immunefi scope). Clone once (see install.sh).
IMMUNEFI_MIRROR=$HOME/immunefi-mirror
# Headless permission flags. Default is safe-ish; permission prompts have no one to answer on a
# server, so on an ISOLATED VPS you will likely need full autonomy:
#   CLAUDE_PERM_FLAGS="--dangerously-skip-permissions"
CLAUDE_PERM_FLAGS="--permission-mode acceptEdits"
WORKER_TIMEOUT=900
# Auth: run `claude` once interactively on the VPS to log in, OR export CLAUDE_CODE_OAUTH_TOKEN
# (generate with `claude setup-token` on a machine where you are logged in).
